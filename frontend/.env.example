# Variables de entorno del frontend (Vite). Copia a `.env` o configuralas en
# Vercel (Settings > Environment Variables; Root Directory = frontend).

# URL base de la API del backend, con /api al final.
#   Render:  https://crm-backend.onrender.com/api
#   Vercel:  https://tu-backend.vercel.app/api
#   Local:   http://localhost:3000/api
VITE_API_URL=https://crm-backend.onrender.com/api

# Client ID de Google para conectar Google Calendar desde Mi Agenda (opcional).
VITE_GOOGLE_CLIENT_ID=

# Notificaciones en tiempo real via Supabase Realtime. Dejar en false: la
# campana se actualiza sola cada 15 s. Si la base esta en Supabase y se quiere
# activar, ademas de estas variables hay que dar permisos de lectura a `anon`
# sobre `notificaciones` (las tablas se crean con RLS activado y sin politicas).
VITE_ENABLE_REALTIME=false
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
