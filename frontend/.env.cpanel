# Variables del build para cPanel (`npm run build:cpanel` = vite build --mode cpanel).
# Pisan a las de `.env`. El frontend y la API comparten subdominio, asi que la
# API va por ruta relativa: sin CORS y sin repetir el dominio aqui.
VITE_API_URL=/api
VITE_ENABLE_REALTIME=false
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
