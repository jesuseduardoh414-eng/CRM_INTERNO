# Frontend del CRM en cPanel (Apache o LiteSpeed). `npm run build:cpanel` lo
# copia a dist/ y va en la carpeta del sitio (public_html), junto a index.html.
#
# La API vive en el mismo subdominio, en /api: la atiende la aplicacion de
# "Setup Node.js App" (Application URL = <subdominio>/api), que crea su propia
# carpeta api/ con otro .htaccess. No borres esa carpeta al actualizar.

DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Todo por HTTPS (menos la validacion del certificado de AutoSSL). Solo en
  # la primera pasada: la reescritura a index.html no debe volver a redirigir.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /api es de la aplicacion Node.js: no se reescribe.
  RewriteRule ^api(/|$) - [L]

  # Archivos y carpetas que existen se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Un .js o .css de assets/ que ya no existe (version anterior) es un 404,
  # no index.html servido como script.
  RewriteRule ^assets/ - [L]

  # El resto son rutas de la aplicacion (React Router): index.html.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # index.html se revisa siempre para que una version nueva se vea al momento.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  # Los .js y .css de Vite llevan un hash en el nombre: no cambian nunca.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
