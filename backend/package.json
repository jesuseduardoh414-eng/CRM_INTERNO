{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "API REST del CRM interno",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:render": "npm run db:migrate && node src/server.js",
    "build": "npm run db:generate",
    "vercel-build": "npm run db:generate",
    "db:generate": "node scripts/prisma.js generate",
    "db:migrate": "node scripts/prisma.js migrate deploy",
    "db:migrate:dev": "node scripts/prisma.js migrate dev",
    "db:status": "node scripts/prisma.js migrate status",
    "db:studio": "node scripts/prisma.js studio",
    "db:schema:postgres": "node scripts/generar_schema_postgres.js",
    "db:migracion:postgres": "node scripts/nueva_migracion_postgres.js",
    "db:copiar": "node scripts/copiar_base.js",
    "crear-configurador": "node scripts/crear_configurador.js",
    "crear-cliente": "node scripts/crear_cliente.js",
    "datos-prueba": "node scripts/datos_prueba.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13",
    "prisma": "^5.0.0",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "mysql2": "^3.11.0",
    "nodemon": "^3.0.1",
    "pg": "^8.23.1"
  }
}
