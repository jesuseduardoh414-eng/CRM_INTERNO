generator client {
  provider = "prisma-client-js"
}

// ESTE ARCHIVO SE GENERA SOLO: NO LO EDITES. Sale de prisma/schema.prisma
// (la fuente unica del modelo, escrita para MySQL) al correr
// `npm run db:generate`, `npm run db:migrate` o `npm run db:schema:postgres`
// (scripts/generar_schema_postgres.js). Los cambios al modelo van en
// prisma/schema.prisma; las migraciones de Postgres, en prisma/postgres/migrations/.
//
// Diferencias con el esquema MySQL (las aplica el generador):
// - provider postgresql y directUrl: DIRECT_URL es la conexion directa (sin
//   pgbouncer) que usan las migraciones; si falta se usa DATABASE_URL.
// - @db.LongText -> @db.Text y @db.MediumBlob -> @db.ByteA (tipos de MySQL que
//   Postgres no tiene). Los Json van como jsonb.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                       Int                     @id @default(autoincrement())
  nombre                   String                  @db.VarChar(255)
  email                    String                  @unique
  password                 String
  telefono                 String?
  puesto                   String?                 @db.VarChar(255)
  biografia                String?                 @db.Text
  fotoPerfilUrl            String?                 @map("foto_perfil_url") @db.Text
  // Claves de configuracion.reglas.areas (editables en el panel), una o varias
  // separadas por coma: "MARKETING,DESARROLLO" (como Proyecto.area).
  area                     String                  @db.VarChar(700)
  rol                      Rol                     @default(MIEMBRO)
  creadoEn                 DateTime                @default(now())
  resetToken               String?
  resetTokenExpires        DateTime?
  verificado               Boolean                 @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  estado                   String?                 @default("pendiente")
  tokenInvitacion          String?                 @unique @map("token_invitacion")
  tokenExpiraEn            DateTime?               @map("token_expira_en")
  passwordHash             String?                 @map("password_hash")
  googleCalendarEmail      String?                 @map("google_calendar_email")
  googleAccessToken        String?                 @map("google_access_token") @db.Text
  googleRefreshToken       String?                 @map("google_refresh_token") @db.Text
  googleTokenExpiresAt     DateTime?               @map("google_token_expires_at")
  // Calendario "OMNIS CRM" que el CRM crea en el Google de la persona y que se
  // sincroniza en los dos sentidos (services/google-calendar.service.js), y la
  // marca de Google para pedir solo lo que cambio desde la ultima vez.
  googleCalendarCrmId      String?                 @map("google_calendar_crm_id") @db.VarChar(255)
  googleCalendarSyncToken  String?                 @map("google_calendar_sync_token") @db.Text
  googleCalendarSyncEn     DateTime?               @map("google_calendar_sync_en")
  // ---- Seguridad de acceso (modulo auth) ----
  // Bloqueo progresivo por cuenta: vive en la base y no en memoria para que
  // valga igual en todas las instancias y sobreviva a reinicios.
  intentosFallidos         Int                     @default(0) @map("intentos_fallidos")
  bloqueadoHasta           DateTime?               @map("bloqueado_hasta")
  ultimoLoginEn            DateTime?               @map("ultimo_login_en")
  passwordCambiadoEn       DateTime?               @map("password_cambiado_en")
  // Intentos fallidos contra el codigo de verificacion de correo vigente.
  verificacionIntentos     Int                     @default(0) @map("verificacion_intentos")
  // Doble factor (TOTP). Los secretos van cifrados con AES-256-GCM y los
  // codigos de respaldo solo como hash SHA-256.
  dosFactoresActivo        Boolean                 @default(false) @map("dos_factores_activo")
  dosFactoresSecreto       String?                 @map("dos_factores_secreto") @db.Text
  dosFactoresPendiente     String?                 @map("dos_factores_pendiente") @db.Text
  dosFactoresUltimoPaso    Int?                    @map("dos_factores_ultimo_paso")
  codigosRespaldo          Json?                   @map("codigos_respaldo")
  sesiones                 Sesion[]
  eventosSeguridad         EventoSeguridad[]
  contratosCreados         Contrato[]              @relation("CreadorContrato")
  contratosResponsable     Contrato[]              @relation("ResponsableContrato")
  empresasCreadas          Empresa[]               @relation("CreadorEmpresa")
  diasEmpresaCreados       DiaEmpresa[]            @relation("CreadorDiaEmpresa")
  archivosContratoSubidos  ContratoArchivo[]
  adjuntos                 Adjunto[]               @relation("AutorAdjunto")
  comentarios              Comentario[]            @relation("AutorComentario")
  actividades              LogActividad[]          @relation("AutorActividad")
  eventos                  Evento[]                @relation("UsuarioEvento")
  eventosCreados           Evento[]                @relation("EventosCreados")
  invitacionesEventos      EventoInvitado[]
  configLaboral            ConfiguracionLaboral?
  diasEspeciales           DiaEspecial[]
  notificaciones           Notificacion[]          @relation("DestinatarioNotificacion")
  proyectosCreados         Proyecto[]              @relation("CreadorProyecto")
  plantillasCreadas        PlantillaProyecto[]     @relation("CreadorPlantillaProyecto")
  tareasCreadas            Tarea[]                 @relation("CreadorTarea")
  tareasAsignadas          Tarea[]                 @relation("AsignadoTarea")
  tareasCompartidas        Tarea[]                 @relation("AsignadosMultiplesTarea")
  proyectosMiembro         Proyecto[]              @relation("ProyectoMiembro")
  invitacionesEnviadas     Invitacion[]            @relation("CreadorInvitacion")
  // Solo rol CLIENTE: la empresa del directorio cuyo portal ve.
  empresaId                Int?                    @map("empresa_id")
  empresa                  Empresa?                @relation("UsuariosPortal", fields: [empresaId], references: [id], onDelete: SetNull)
  mensajesPortal           MensajePortal[]         @relation("AutorMensajePortal")
  // ---- Finanzas ----
  // Que puede ver o editar en Ventas, Tesoreria, cada categoria de gastos y
  // el informe: { ventas: 'ver', gastos: { FIJOS: 'editar' }, ... }. null =
  // sin acceso. El administrador global siempre puede todo (no se consulta).
  // Validado en utils/finanzas.utils.js.
  permisosFinanzas         Json?                   @map("permisos_finanzas")
  // Ajustes de permisos de esta persona sobre los de su area y rol
  // ({ "clientes.ver": true, "proyectos.ver": "todos", ... }, solo lo que
  // cambia; utils/permisosArea.utils.js). null = igual que su area. Mientras
  // sea null, sus permisos_finanzas anteriores cuentan como ajustes.
  permisos                 Json?
  pagosRegistrados         Pago[]                  @relation("CreadorPago")
  gastosRegistrados        Gasto[]                 @relation("CreadorGasto")
  asignacionesHechas       AsignacionPartida[]     @relation("CreadorAsignacion")
  presupuestosFijados      PresupuestoCategoria[]  @relation("FijaPresupuesto")
  comprobantesSubidos      ComprobanteFinanciero[] @relation("SubeComprobante")
  cotizacionesRegistradas  Cotizacion[]            @relation("CreadorCotizacion")
  versionesCotizacion      VersionCotizacion[]     @relation("SubeVersionCotizacion")
  articulosEscritos        ArticuloConocimiento[]  @relation("AutorArticulo")
  articulosEditados        ArticuloConocimiento[]  @relation("EditorArticulo")
  archivosConocimiento     ArchivoConocimiento[]   @relation("SubeArchivoConocimiento")
  accesosConocimiento      AccesoConocimiento[]    @relation("AccesoConocimientoPersona")
  elementosBorrados        ElementoBorrado[]       @relation("BorradoPor")
  registrosActividad       RegistroActividad[]     @relation("AutorRegistro")

  @@index([empresaId])
  @@map("usuarios")
}

// Una fila por dispositivo con sesion abierta. El refresh token solo se guarda
// como hash SHA-256 y rota en cada uso; si llega un token ya rotado (fuera del
// margen de concurrencia) se asume robo y la sesion se revoca entera.
model Sesion {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  usuarioId           Int       @map("usuario_id")
  refreshHash         String    @unique @map("refresh_hash") @db.VarChar(64)
  refreshHashAnterior String?   @map("refresh_hash_anterior") @db.VarChar(64)
  rotadoEn            DateTime? @map("rotado_en")
  recordar            Boolean   @default(false)
  ip                  String?   @db.VarChar(64)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  creadoEn            DateTime  @default(now()) @map("creado_en")
  ultimoUso           DateTime  @default(now()) @map("ultimo_uso")
  expiraEn            DateTime  @map("expira_en")
  revocadaEn          DateTime? @map("revocada_en")
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([refreshHashAnterior])
  @@map("sesiones")
}

// Bitacora de seguridad: inicios de sesion, fallos, bloqueos, cambios de
// contraseña y de doble factor. La ve cada persona en su perfil.
model EventoSeguridad {
  id        Int      @id @default(autoincrement())
  usuarioId Int?     @map("usuario_id")
  email     String?  @db.VarChar(191)
  tipo      String   @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  detalle   String?  @db.Text
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadoEn])
  @@map("eventos_seguridad")
}

// Contratos con clientes y proveedores. Solo los ven los administradores
// (se exige en el backend, no solo en el menu).
// - folio: CTR-AAAA-NNNN, se asigna al crear.
// - estado guardado: BORRADOR | EN_REVISION | VIGENTE | TERMINADO | CANCELADO.
//   "Vencido" y "por vencer" no se guardan: se calculan con fechaFin, para que
//   nunca queden desactualizados.
model Contrato {
  id                   Int               @id @default(autoincrement())
  folio                String            @unique @db.VarChar(40)
  titulo               String            @db.VarChar(255)
  tipo                 String            @db.VarChar(20)
  categoria            String?           @db.VarChar(40)
  estado               String            @default("BORRADOR") @db.VarChar(20)
  contraparteNombre    String            @map("contraparte_nombre") @db.VarChar(255)
  contraparteRfc       String?           @map("contraparte_rfc") @db.VarChar(13)
  contraparteContacto  String?           @map("contraparte_contacto") @db.VarChar(255)
  contraparteEmail     String?           @map("contraparte_email") @db.VarChar(191)
  contraparteTelefono  String?           @map("contraparte_telefono") @db.VarChar(40)
  descripcion          String?           @db.Text
  monto                Decimal?          @db.Decimal(14, 2)
  moneda               String            @default("MXN") @db.VarChar(3)
  incluyeIva           Boolean           @default(false) @map("incluye_iva")
  periodicidadPago     String?           @map("periodicidad_pago") @db.VarChar(20)
  fechaFirma           DateTime?         @map("fecha_firma") @db.Date
  fechaInicio          DateTime?         @map("fecha_inicio") @db.Date
  fechaFin             DateTime?         @map("fecha_fin") @db.Date
  renovacionAutomatica Boolean           @default(false) @map("renovacion_automatica")
  diasAviso            Int               @default(30) @map("dias_aviso")
  notas                String?           @db.Text
  proyectoId           Int?              @map("proyecto_id")
  // Ficha del directorio de clientes y proveedores. Los campos contraparte*
  // se conservan como foto de los datos al firmar.
  empresaId            Int?              @map("empresa_id")
  responsableId        Int?              @map("responsable_id")
  creadoPorId          Int?              @map("creado_por_id")
  creadoEn             DateTime          @default(now()) @map("creado_en")
  actualizadoEn        DateTime          @updatedAt @map("actualizado_en")
  proyecto             Proyecto?         @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  empresa              Empresa?          @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  responsable          Usuario?          @relation("ResponsableContrato", fields: [responsableId], references: [id], onDelete: SetNull)
  creadoPor            Usuario?          @relation("CreadorContrato", fields: [creadoPorId], references: [id], onDelete: SetNull)
  archivos             ContratoArchivo[]
  pagos                Pago[]

  @@index([tipo])
  @@index([estado])
  @@index([fechaFin])
  @@index([empresaId])
  @@map("contratos")
}

// Directorio de clientes y proveedores (solo administradores).
model Empresa {
  id              Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(255) // razón social o nombre
  nombreComercial String?           @map("nombre_comercial") @db.VarChar(255)
  tipo            String            @default("CLIENTE") @db.VarChar(20) // CLIENTE | PROVEEDOR | AMBOS
  estado          String            @default("ACTIVO") @db.VarChar(20) // ACTIVO | INACTIVO
  rfc             String?           @db.VarChar(13)
  sector          String?           @db.VarChar(80)
  sitioWeb        String?           @map("sitio_web") @db.VarChar(255)
  email           String?           @db.VarChar(191)
  telefono        String?           @db.VarChar(40)
  direccion       String?           @db.VarChar(500)
  ciudad          String?           @db.VarChar(120)
  notas           String?           @db.Text
  creadoPorId     Int?              @map("creado_por_id")
  creadoEn        DateTime          @default(now()) @map("creado_en")
  actualizadoEn   DateTime          @updatedAt @map("actualizado_en")
  creadoPor       Usuario?          @relation("CreadorEmpresa", fields: [creadoPorId], references: [id], onDelete: SetNull)
  contactos       ContactoEmpresa[]
  contratos       Contrato[]
  proyectos       Proyecto[]
  usuariosPortal  Usuario[]         @relation("UsuariosPortal")
  invitaciones    Invitacion[]
  reuniones       Evento[]
  pagos           Pago[] // como cliente que paga
  gastos          Gasto[] // como proveedor al que se le paga
  cotizaciones    Cotizacion[] // proveedor que cotiza o cliente al que se cotiza

  @@index([tipo])
  @@index([nombre])
  @@map("empresas")
}

model ContactoEmpresa {
  id        Int      @id @default(autoincrement())
  empresaId Int      @map("empresa_id")
  nombre    String   @db.VarChar(255)
  puesto    String?  @db.VarChar(120)
  email     String?  @db.VarChar(191)
  telefono  String?  @db.VarChar(40)
  principal Boolean  @default(false)
  notas     String?  @db.Text
  creadoEn  DateTime @default(now()) @map("creado_en")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("contactos_empresa")
}

// PDF escaneados de un contrato. El archivo vive en disco (CONTRATOS_DIR),
// fuera de cualquier carpeta publica, y solo se sirve a un admin autenticado.
// `archivo` es el nombre interno (uuid.pdf); `nombreOriginal` el que subio la persona.
model ContratoArchivo {
  id             String   @id @default(uuid()) @db.VarChar(36)
  contratoId     Int      @map("contrato_id")
  nombreOriginal String   @map("nombre_original") @db.VarChar(255)
  archivo        String   @unique @db.VarChar(80)
  tamano         Int
  sha256         String   @db.VarChar(64)
  tipoDocumento  String   @default("FIRMADO") @map("tipo_documento") @db.VarChar(20)
  subidoPorId    Int?     @map("subido_por_id")
  creadoEn       DateTime @default(now()) @map("creado_en")
  contrato       Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  subidoPor      Usuario? @relation(fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@index([contratoId])
  @@map("contrato_archivos")
}

// Configuracion de la instalacion (una sola fila, id = 1). `datos` es un JSON
// validado y completado con valores por defecto en utils/configuracion.utils.js.
model Configuracion {
  id               Int      @id @default(1)
  datos            Json
  version          Int      @default(1)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")
  actualizadoPorId Int?     @map("actualizado_por_id")

  @@map("configuracion")
}

// Imagenes de marca (logos, favicon, fondo del login). Son publicas (la
// pantalla de login las muestra antes de iniciar sesion), por eso viven en la
// base y se sirven con cabeceras estrictas desde /api/configuracion/archivos.
model ConfiguracionArchivo {
  clave         String   @id @db.VarChar(40)
  mime          String   @db.VarChar(60)
  contenido     Bytes    @db.ByteA
  sha256        String   @db.VarChar(64)
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_archivos")
}

model Invitacion {
  id        String   @id @default(uuid()) @db.VarChar(36)
  email     String
  nombre    String   @db.VarChar(255)
  // Una o varias areas separadas por coma, como Usuario.area.
  area      String   @db.VarChar(700)
  rol       String   @default("miembro")
  token     String   @unique
  estado    String   @default("pendiente")
  creadoPor Int?     @map("creado_por")
  creadoEn  DateTime @default(now()) @map("creado_en")
  expiraEn  DateTime @map("expira_en")
  creador   Usuario? @relation("CreadorInvitacion", fields: [creadoPor], references: [id])
  // Invitaciones al portal de clientes (rol "cliente"): empresa que verá.
  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("invitaciones")
}

model Proyecto {
  id             Int                 @id @default(autoincrement())
  nombre         String              @db.VarChar(255)
  descripcion    String?             @db.Text
  estado         String              @default("ACTIVO")
  creadoEn       DateTime            @default(now())
  creadorId      Int
  area           String              @default("DESARROLLO")
  fechaFin       DateTime?
  fechaInicio    DateTime            @default(now())
  clienteId      Int?                @map("cliente_id")
  cliente        Empresa?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  adjuntos       Adjunto[]
  comentarios    Comentario[]
  actividades    LogActividad[]
  creador        Usuario             @relation("CreadorProyecto", fields: [creadorId], references: [id])
  tareas         Tarea[]
  notificaciones Notificacion[]
  miembros       Usuario[]           @relation("ProyectoMiembro")
  eventos        Evento[]
  plantillasBase PlantillaProyecto[] @relation("ProyectoFuentePlantillas")
  contratos      Contrato[]
  mensajesPortal MensajePortal[]
  pagos          Pago[]

  // Carpeta del proyecto en Google Drive (Archivos del CRM › Proyectos › …),
  // donde van sus adjuntos y se leen los que se agreguen desde Drive.
  driveCarpetaId String? @map("drive_carpeta_id") @db.VarChar(100)

  @@index([clienteId])
  @@map("proyectos")
}

model PlantillaProyecto {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(255)
  descripcion    String?          @db.Text
  area           String           @default("DESARROLLO")
  creadoEn       DateTime         @default(now())
  creadorId      Int
  proyectoBaseId Int?
  creador        Usuario          @relation("CreadorPlantillaProyecto", fields: [creadorId], references: [id])
  proyectoBase   Proyecto?        @relation("ProyectoFuentePlantillas", fields: [proyectoBaseId], references: [id], onDelete: SetNull)
  tareas         PlantillaTarea[]

  @@map("plantillas_proyecto")
}

model PlantillaTarea {
  id               Int               @id @default(autoincrement())
  plantillaId      Int
  clave            String
  titulo           String            @db.VarChar(255)
  descripcion      String?           @db.Text
  prioridad        String            @default("MEDIA")
  orden            Int               @default(0)
  offsetInicioDias Int               @default(0)
  offsetVenceDias  Int?
  dependeDeClave   String?
  plantilla        PlantillaProyecto @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  @@unique([plantillaId, clave])
  @@map("plantillas_tarea")
}

model Tarea {
  id              Int            @id @default(autoincrement())
  titulo          String         @db.VarChar(255)
  descripcion     String?        @db.Text
  numeroActividad Int?
  estado          String         @default("PENDIENTE")
  prioridad       String         @default("MEDIA")
  creadoEn        DateTime       @default(now())
  completadoEn    DateTime?
  venceEn         DateTime?
  proyectoId      Int
  asignadoId      Int?
  creadorId       Int?
  dependeDeId     Int?
  fechaInicio     DateTime       @default(now())
  adjuntos        Adjunto[]
  comentarios     Comentario[]
  actividades     LogActividad[]
  asignado        Usuario?       @relation("AsignadoTarea", fields: [asignadoId], references: [id])
  asignados       Usuario[]      @relation("AsignadosMultiplesTarea")
  creador         Usuario?       @relation("CreadorTarea", fields: [creadorId], references: [id])
  dependeDe       Tarea?         @relation("Dependencia", fields: [dependeDeId], references: [id])
  bloqueaA        Tarea[]        @relation("Dependencia")
  proyecto        Proyecto       @relation(fields: [proyectoId], references: [id])
  notificaciones  Notificacion[]

  @@index([asignadoId])
  @@index([creadorId])
  @@index([estado])
  // Carpeta de la tarea dentro de la de su proyecto en Google Drive.
  driveCarpetaId  String?        @map("drive_carpeta_id") @db.VarChar(100)

  @@index([proyectoId, numeroActividad])
  @@map("tareas")
}

model Notificacion {
  id          Int       @id @default(autoincrement())
  mensaje     String    @db.Text
  tipo        String
  leida       Boolean   @default(false)
  creadaEn    DateTime  @default(now())
  usuarioId   Int
  tareaId     Int?
  proyectoId  Int?
  eventoId    String?   @db.VarChar(36)
  actorNombre String?   @db.VarChar(255)
  usuario     Usuario   @relation("DestinatarioNotificacion", fields: [usuarioId], references: [id], onDelete: Cascade)
  tarea       Tarea?    @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  proyecto    Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  evento      Evento?   @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  @@map("notificaciones")
}

model Comentario {
  id         Int       @id @default(autoincrement())
  contenido  String    @db.Text
  creadoEn   DateTime  @default(now())
  autorId    Int
  tareaId    Int?
  proyectoId Int?
  autor      Usuario   @relation("AutorComentario", fields: [autorId], references: [id], onDelete: Cascade)
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tarea      Tarea?    @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

model LogActividad {
  id          Int      @id @default(autoincrement())
  accion      String
  descripcion String   @db.Text
  creadoEn    DateTime @default(now())
  usuarioId   Int
  proyectoId  Int
  tareaId     Int?
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tarea       Tarea?   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation("AutorActividad", fields: [usuarioId], references: [id])

  @@map("logs_actividad")
}

model Adjunto {
  id             Int       @id @default(autoincrement())
  nombre         String    @db.VarChar(255)
  url            String    @db.Text
  tipo           String?
  tamano         Int?
  creadoEn       DateTime  @default(now())
  usuarioId      Int
  tareaId        Int?
  proyectoId     Int?
  eventoId       String?   @db.VarChar(36)
  // Lo ve el cliente en su portal (solo archivos del proyecto, no de tareas).
  visibleCliente Boolean   @default(false) @map("visible_cliente")
  proyecto       Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tarea          Tarea?    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  evento         Evento?   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario        Usuario   @relation("AutorAdjunto", fields: [usuarioId], references: [id])

  // Archivo en Google Drive (adjuntos de proyecto y tarea en sus carpetas):
  // su url es /api/archivos/drive/<id>. desdeDrive: lo agrego alguien en Drive.
  driveArchivoId String?   @map("drive_archivo_id") @db.VarChar(100)
  desdeDrive     Boolean   @default(false) @map("desde_drive")

  @@index([driveArchivoId])
  @@map("adjuntos")
}

// Modelo de Agenda Personal y Compartida
model Evento {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  usuarioId           Int // Creador/Propietario original (Phase 8 logic)
  usuario             Usuario   @relation("UsuarioEvento", fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo              String    @db.VarChar(255)
  descripcion         String?   @db.Text
  tipo                String // 'evento', 'recordatorio', 'dia_completo'
  modalidad           String    @default("presencial")
  ubicacion           String?   @db.VarChar(255)
  urlReunion          String?   @map("url_reunion") @db.Text
  instruccionesAcceso String?   @map("instrucciones_acceso") @db.Text
  fechaInicio         DateTime  @map("fecha_inicio")
  fechaFin            DateTime? @map("fecha_fin")
  todoElDia           Boolean   @default(false) @map("todo_el_dia")
  color               String    @default("#4a90d9")
  alertaMinutos       Int?      @map("alerta_minutos")
  creadoEn            DateTime  @default(now()) @map("creado_en")

  // Phase 8.1 - Compartidos
  esCompartido   Boolean          @default(false) @map("es_compartido")
  esGlobal       Boolean          @default(false) @map("es_global")
  proyectoId     Int?             @map("proyecto_id")
  proyecto       Proyecto?        @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  creadoPorId    Int?             @map("creado_por_id")
  creador        Usuario?         @relation("EventosCreados", fields: [creadoPorId], references: [id], onDelete: SetNull)
  invitados      EventoInvitado[]
  adjuntos       Adjunto[]
  notificaciones Notificacion[]

  // Recurrencia
  esRecurrente          Boolean   @default(false) @map("es_recurrente")
  patronRecurrencia     String?   @map("patron_recurrencia") @db.Text // JSON: { tipo:'semanal', dias:[0,6], horaInicio:'09:00', horaFin:'18:00' }
  fechaFinRecurr        DateTime? @map("fecha_fin_recurrencia")
  googleCalendarEventId String?   @map("google_calendar_event_id") @db.VarChar(255)
  // etag de la ultima version que el CRM escribio o leyo de Google: si un
  // cambio que llega de Google trae el mismo, es el eco del propio CRM.
  googleEtag            String?   @map("google_etag") @db.VarChar(255)
  actualizadoEn         DateTime  @default(now()) @updatedAt @map("actualizado_en")
  // Reunión con un cliente: aparece en el portal de esa empresa.
  empresaId             Int?      @map("empresa_id")
  empresa               Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([usuarioId, googleCalendarEventId])
  @@map("eventos")
}

model EventoInvitado {
  id        String  @id @default(uuid()) @db.VarChar(36)
  eventoId  String  @map("evento_id") @db.VarChar(36)
  usuarioId Int     @map("usuario_id")
  estado    String  @default("pendiente") // 'pendiente', 'aceptado', 'rechazado'
  visto     Boolean @default(false)
  evento    Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([eventoId, usuarioId])
  @@map("evento_invitados")
}

model ConfiguracionLaboral {
  id               String   @id @default(uuid()) @db.VarChar(36)
  usuarioId        Int      @unique @map("usuario_id")
  // Lista de dias (1 = lunes ... 7 = domingo). MySQL no tiene listas, asi que
  // va como JSON; el valor por defecto [1,2,3,4,5] lo pone el controlador.
  diasLaborales    Json     @map("dias_laborales")
  horaEntrada      String   @default("09:00") @map("hora_entrada")
  horaSalida       String   @default("18:00") @map("hora_salida")
  horaComidaInicio String   @default("14:00") @map("hora_comida_inicio")
  horaComidaFin    String   @default("15:00") @map("hora_comida_fin")
  // Dias con horario distinto al general (p. ej. sabado medio turno):
  // { "6": { entrada, salida, comidaInicio, comidaFin } }. Ver utils/horarios.utils.js
  horariosPorDia   Json?    @map("horarios_por_dia")
  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("calendario_laboral")
}

model DiaEspecial {
  id          String   @id @default(uuid()) @db.VarChar(36)
  usuarioId   Int      @map("usuario_id")
  fecha       DateTime @db.Date
  tipo        String // 'vacacion', 'permiso', 'descanso', 'incapacidad', 'homeoffice', 'cumpleanos'
  descripcion String?  @db.Text
  // Solo una parte del dia (p. ej. permiso de 10:00 a 12:00). null = todo el dia.
  horaInicio  String?  @map("hora_inicio") @db.VarChar(5)
  horaFin     String?  @map("hora_fin") @db.VarChar(5)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, fecha])
  @@map("dias_especiales")
}

// CONFIGURADOR: cuenta de quien instala/vende el CRM. Solo entra al panel de
// configuracion (marca, colores, login, modulos); no ve datos de la empresa ni
// aparece en las listas del equipo. Se crea con scripts/crear_configurador.js.
enum Rol {
  ADMIN
  MIEMBRO
  CONFIGURADOR
  CLIENTE
}

// Conversación de un proyecto entre el cliente (portal) y el equipo. Va
// aparte de los comentarios internos para que el cliente nunca los vea.
model MensajePortal {
  id         Int      @id @default(autoincrement())
  proyectoId Int      @map("proyecto_id")
  autorId    Int      @map("autor_id")
  contenido  String   @db.Text
  deCliente  Boolean  @default(false) @map("de_cliente")
  creadoEn   DateTime @default(now()) @map("creado_en")
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  autor      Usuario  @relation("AutorMensajePortal", fields: [autorId], references: [id], onDelete: Cascade)

  @@index([proyectoId, creadoEn])
  @@index([autorId])
  @@map("mensajes_portal")
}

// Calendario de la empresa: festivos, días no laborables, cierres, puentes y
// días especiales que aplican a todos (area null) o a un área. Los marca un
// administrador. repetirAnual: se repite cada año en las mismas fechas.
model DiaEmpresa {
  id           String   @id @default(uuid()) @db.VarChar(36)
  fechaInicio  DateTime @map("fecha_inicio") @db.Date
  fechaFin     DateTime @map("fecha_fin") @db.Date
  tipo         String   @db.VarChar(20) // festivo | no_laboral | cierre | puente | especial
  nombre       String   @db.VarChar(120)
  descripcion  String?  @db.Text
  repetirAnual Boolean  @default(false) @map("repetir_anual")
  // Repeticion semanal dentro del periodo: [1..7] (1 = lunes). null = todos los dias.
  // Sin fecha de fin ("todas las semanas") se guarda fechaFin = 2099-12-31.
  diasSemana   Json?    @map("dias_semana")
  area         String?  @db.VarChar(40)
  creadoPorId  Int?     @map("creado_por_id")
  creadoEn     DateTime @default(now()) @map("creado_en")
  creadoPor    Usuario? @relation("CreadorDiaEmpresa", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([fechaInicio])
  @@map("dias_empresa")
}

// Avisos por correo ya enviados (recordatorios de eventos, resumen diario...).
// `clave` identifica el aviso para no mandarlo dos veces.
model AvisoEnviado {
  clave    String   @id @db.VarChar(191)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@map("avisos_enviados")
}

// Conexion con Google Drive (una sola fila, id = 1): la cuenta de Google en
// cuyo Drive se guardan los archivos del CRM y los respaldos diarios de la
// base (services/drive.service.js). El permiso es "drive.file": el CRM solo ve
// los archivos que el mismo crea. Va aparte de la configuracion para que
// "restablecer" el panel nunca corte el acceso a los archivos.
model ConexionDrive {
  id                  Int       @id @default(1)
  cuenta              String    @db.VarChar(191)
  refreshTokenCifrado String    @map("refresh_token_cifrado") @db.Text
  carpetaId           String?   @map("carpeta_id") @db.VarChar(100)
  // ok | revocada (Google retiro el permiso: hay que volver a conectar)
  estado              String    @default("ok") @db.VarChar(20)
  ultimoError         String?   @map("ultimo_error") @db.VarChar(500)
  ultimoRespaldoEn    DateTime? @map("ultimo_respaldo_en")
  ultimoRespaldoBytes Int?      @map("ultimo_respaldo_bytes")
  conectadoPorId      Int?      @map("conectado_por_id")
  conectadoEn         DateTime  @default(now()) @map("conectado_en")
  actualizadoEn       DateTime  @updatedAt @map("actualizado_en")
  // Permisos que dio la cuenta (desde 2026-10-20 se pide todo Drive para leer
  // lo que se agrega a mano en las carpetas de proyecto), la carpeta
  // "Proyectos" y la marca de la lista de cambios de Drive.
  alcance             String?   @db.VarChar(500)
  proyectosCarpetaId  String?   @map("proyectos_carpeta_id") @db.VarChar(100)
  cambiosToken        String?   @map("cambios_token") @db.VarChar(255)
  cambiosEn           DateTime? @map("cambios_en")

  @@map("conexion_drive")
}

// ---------------------------------------------------------------------------
// Finanzas: Ventas (pagos recibidos), Tesoreria (partidas) y Gastos.
// Los montos son Decimal(14,2); los importes se suman en la base o con
// Prisma.Decimal, nunca con float. Los valores cerrados (estado, metodo,
// categoria) son VarChar validados en utils/finanzas.utils.js.
// ---------------------------------------------------------------------------

// Cuenta a la que entra el dinero (o de la que sale): banco, caja, pasarela.
// Catalogo editable desde Ventas / Tesoreria.
model CuentaFinanciera {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(120)
  tipo       String   @default("BANCO") @db.VarChar(20) // BANCO | EFECTIVO | PASARELA | OTRA
  banco      String?  @db.VarChar(80)
  referencia String?  @db.VarChar(40) // alias, ultimos digitos
  activa     Boolean  @default(true)
  orden      Int      @default(0)
  creadoEn   DateTime @default(now()) @map("creado_en")
  pagos      Pago[]
  gastos     Gasto[]

  @@map("cuentas_financieras")
}

// Presupuesto mensual de una categoria de gastos, fijado en Tesoreria (uno
// por categoria y mes). Sale de la bolsa de ingresos: mientras el mes esta
// abierto aparta el monto (o lo gastado, si ya se paso); al cerrar el mes solo
// cuenta lo gastado y el remanente vuelve a la bolsa. Calculo en
// services/presupuestos.service.js.
model PresupuestoCategoria {
  id            Int      @id @default(autoincrement())
  categoria     String   @db.VarChar(30)
  anio          Int
  mes           Int // 1-12
  monto         Decimal  @db.Decimal(14, 2)
  fijadoPorId   Int?     @map("fijado_por_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  fijadoPor     Usuario? @relation("FijaPresupuesto", fields: [fijadoPorId], references: [id], onDelete: SetNull)

  @@unique([categoria, anio, mes])
  @@index([anio, mes])
  @@map("presupuestos_categoria")
}

// Partida de tesoreria: "sobre" al que se apartaba dinero de la bolsa
// (Marketing, Caja chica, Ahorro...). Desde el 2026-10-14 los presupuestos
// son por categoria (PresupuestoCategoria): las partidas quedaron archivadas
// y solo se conservan como historial (gastos viejos y vista del informe).
model Partida {
  id           Int                 @id @default(autoincrement())
  nombre       String              @db.VarChar(80)
  color        String?             @db.VarChar(9)
  descripcion  String?             @db.VarChar(255)
  activa       Boolean             @default(true)
  orden        Int                 @default(0)
  creadoEn     DateTime            @default(now()) @map("creado_en")
  asignaciones AsignacionPartida[]
  gastos       Gasto[]

  @@map("partidas")
}

// Dinero de la bolsa de ingresos apartado para una partida. El saldo de la
// partida = asignado - gastado (gastos no anulados con esa partida).
model AsignacionPartida {
  id          Int      @id @default(autoincrement())
  partidaId   Int      @map("partida_id")
  monto       Decimal  @db.Decimal(14, 2)
  fecha       DateTime @db.Date
  nota        String?  @db.VarChar(255)
  creadoPorId Int?     @map("creado_por_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  partida     Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  creadoPor   Usuario? @relation("CreadorAsignacion", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([partidaId])
  @@index([fecha])
  @@map("asignaciones_partida")
}

// Pago recibido de un cliente (ingreso). `clienteNombre` guarda el nombre tal
// como estaba al registrar, por si la ficha cambia o no existe en el directorio.
model Pago {
  id              Int                     @id @default(autoincrement())
  folio           String                  @unique @db.VarChar(40) // PAG-2026-0001
  concepto        String                  @db.VarChar(255)
  monto           Decimal                 @db.Decimal(14, 2)
  moneda          String                  @default("MXN") @db.VarChar(3)
  fecha           DateTime                @db.Date
  metodo          String                  @default("TRANSFERENCIA") @db.VarChar(20) // TRANSFERENCIA | EFECTIVO | TARJETA | CHEQUE | DEPOSITO | OTRO
  referencia      String?                 @db.VarChar(80)
  origen          String                  @default("MANUAL") @db.VarChar(20)
  estado          String                  @default("REGISTRADO") @db.VarChar(20) // REGISTRADO | ANULADO
  motivoAnulacion String?                 @map("motivo_anulacion") @db.VarChar(255)
  notas           String?                 @db.Text
  empresaId       Int?                    @map("empresa_id")
  clienteNombre   String?                 @map("cliente_nombre") @db.VarChar(255)
  cuentaId        Int?                    @map("cuenta_id")
  contratoId      Int?                    @map("contrato_id")
  proyectoId      Int?                    @map("proyecto_id")
  creadoPorId     Int?                    @map("creado_por_id")
  creadoEn        DateTime                @default(now()) @map("creado_en")
  actualizadoEn   DateTime                @updatedAt @map("actualizado_en")
  empresa         Empresa?                @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  cuenta          CuentaFinanciera?       @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  contrato        Contrato?               @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  proyecto        Proyecto?               @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  creadoPor       Usuario?                @relation("CreadorPago", fields: [creadoPorId], references: [id], onDelete: SetNull)
  comprobantes    ComprobanteFinanciero[]

  @@index([fecha])
  @@index([estado])
  @@index([empresaId])
  @@index([cuentaId])
  @@map("pagos")
}

// Gasto registrado en una categoria (PRESUPUESTO_GENERAL, PRESUPUESTO_OFICINA,
// NOMINA, FIJOS, VARIABLES, OTROS). `fechaLimite` es la fecha tope para
// pagarlo (sale en la agenda mientras este PENDIENTE); `pagadoEn`, cuando se
// pago. `fecha` es la fecha contable que agrupa el informe por mes.
model Gasto {
  id              Int                     @id @default(autoincrement())
  folio           String                  @unique @db.VarChar(40) // GAS-2026-0001
  categoria       String                  @db.VarChar(30)
  concepto        String                  @db.VarChar(255)
  descripcion     String?                 @db.Text
  monto           Decimal                 @db.Decimal(14, 2)
  moneda          String                  @default("MXN") @db.VarChar(3)
  fecha           DateTime                @db.Date
  fechaLimite     DateTime?               @map("fecha_limite") @db.Date
  pagadoEn        DateTime?               @map("pagado_en") @db.Date
  estado          String                  @default("PENDIENTE") @db.VarChar(20) // PENDIENTE | PAGADO | ANULADO
  metodo          String?                 @db.VarChar(20)
  referencia      String?                 @db.VarChar(80)
  motivoAnulacion String?                 @map("motivo_anulacion") @db.VarChar(255)
  notas           String?                 @db.Text
  partidaId       Int?                    @map("partida_id")
  empresaId       Int?                    @map("empresa_id") // proveedor
  proveedorNombre String?                 @map("proveedor_nombre") @db.VarChar(255)
  cuentaId        Int?                    @map("cuenta_id")
  creadoPorId     Int?                    @map("creado_por_id")
  creadoEn        DateTime                @default(now()) @map("creado_en")
  actualizadoEn   DateTime                @updatedAt @map("actualizado_en")
  partida         Partida?                @relation(fields: [partidaId], references: [id], onDelete: SetNull)
  empresa         Empresa?                @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  cuenta          CuentaFinanciera?       @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  creadoPor       Usuario?                @relation("CreadorGasto", fields: [creadoPorId], references: [id], onDelete: SetNull)
  comprobantes    ComprobanteFinanciero[]

  @@index([categoria])
  @@index([fecha])
  @@index([fechaLimite])
  @@index([estado])
  @@index([partidaId])
  @@map("gastos")
}

// Comprobante de un pago (transferencia) o de un gasto (factura, ticket).
// Vive en disco fuera de cualquier carpeta publica (COMPROBANTES_DIR) y solo
// se sirve a quien puede ver ese pago o gasto. `archivo` es el nombre interno.
model ComprobanteFinanciero {
  id             String   @id @default(uuid()) @db.VarChar(36)
  pagoId         Int?     @map("pago_id")
  gastoId        Int?     @map("gasto_id")
  nombreOriginal String   @map("nombre_original") @db.VarChar(255)
  archivo        String   @unique @db.VarChar(80)
  mime           String   @db.VarChar(60)
  tamano         Int
  sha256         String   @db.VarChar(64)
  subidoPorId    Int?     @map("subido_por_id")
  creadoEn       DateTime @default(now()) @map("creado_en")
  pago           Pago?    @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  gasto          Gasto?   @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  subidoPor      Usuario? @relation("SubeComprobante", fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@index([pagoId])
  @@index([gastoId])
  @@map("comprobantes_financieros")
}

// Bitacora de finanzas. Sin llave foranea a la entidad para que sobreviva a
// los borrados (quien borro que, cuando). `usuarioNombre` es una foto del
// nombre por si la cuenta se desactiva o cambia.
model LogFinanzas {
  id            Int      @id @default(autoincrement())
  entidad       String   @db.VarChar(20) // pago | gasto | presupuesto | cotizacion | cuenta | partida | asignacion (los comprobantes se anotan en su pago o gasto)
  entidadId     Int      @map("entidad_id")
  accion        String   @db.VarChar(30)
  descripcion   String   @db.Text
  usuarioId     Int?     @map("usuario_id")
  usuarioNombre String?  @map("usuario_nombre") @db.VarChar(255)
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@index([entidad, entidadId])
  @@index([creadoEn])
  @@map("logs_finanzas")
}

// Cotizacion (finanzas): recibida de un proveedor o enviada a un cliente. Sus
// archivos son versiones que nunca se reemplazan ni se borran (la 1 es la
// original); los cambios se suben como versiones nuevas. Solo el
// administrador global corrige los datos, cambia el estado o la elimina
// completa. `contraparteNombre` guarda el nombre tal como estaba al registrar.
model Cotizacion {
  id                Int                 @id @default(autoincrement())
  folio             String              @unique @db.VarChar(40) // COT-2026-0001
  tipo              String              @db.VarChar(20) // RECIBIDA (de un proveedor) | ENVIADA (a un cliente)
  titulo            String              @db.VarChar(255)
  descripcion       String?             @db.Text
  empresaId         Int?                @map("empresa_id")
  contraparteNombre String?             @map("contraparte_nombre") @db.VarChar(255)
  moneda            String              @default("MXN") @db.VarChar(3)
  fecha             DateTime            @db.Date
  estado            String              @default("PENDIENTE") @db.VarChar(20) // PENDIENTE | APROBADA | RECHAZADA
  creadoPorId       Int?                @map("creado_por_id")
  creadoEn          DateTime            @default(now()) @map("creado_en")
  actualizadoEn     DateTime            @updatedAt @map("actualizado_en")
  empresa           Empresa?            @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  creadoPor         Usuario?            @relation("CreadorCotizacion", fields: [creadoPorId], references: [id], onDelete: SetNull)
  versiones         VersionCotizacion[]

  @@index([tipo])
  @@index([estado])
  @@index([fecha])
  @@index([empresaId])
  @@map("cotizaciones")
}

// Un archivo de una cotizacion, con el monto de esa version (para ver cuanto
// cambio) y la nota de que cambio. En disco (COTIZACIONES_DIR), no se edita.
model VersionCotizacion {
  id             Int        @id @default(autoincrement())
  cotizacionId   Int        @map("cotizacion_id")
  numero         Int // 1 = la original
  monto          Decimal?   @db.Decimal(14, 2)
  nota           String?    @db.Text
  nombreOriginal String     @map("nombre_original") @db.VarChar(255)
  archivo        String     @unique @db.VarChar(80)
  mime           String     @db.VarChar(100)
  tamano         Int
  sha256         String     @db.VarChar(64)
  subidoPorId    Int?       @map("subido_por_id")
  creadoEn       DateTime   @default(now()) @map("creado_en")
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  subidoPor      Usuario?   @relation("SubeVersionCotizacion", fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@unique([cotizacionId, numero])
  @@map("versiones_cotizacion")
}

// Articulo de la base de conocimiento (procedimientos, guias, preguntas
// frecuentes). Lo escriben los administradores y lo lee todo el equipo; un
// borrador (publicado = false) solo lo ven los administradores. `contenido`
// es texto con formato basico tipo Markdown que el frontend pinta sin HTML.
// Con `restringido` solo lo ven quienes esten en sus accesos (ademas del
// administrador general y de quien lo escribio).
model ArticuloConocimiento {
  id            Int                   @id @default(autoincrement())
  titulo        String                @db.VarChar(200)
  categoria     String                @db.VarChar(80)
  resumen       String?               @db.VarChar(300)
  contenido     String                @db.Text
  publicado     Boolean               @default(true)
  fijado        Boolean               @default(false)
  restringido   Boolean               @default(false)
  autorId       Int?                  @map("autor_id")
  editadoPorId  Int?                  @map("editado_por_id")
  creadoEn      DateTime              @default(now()) @map("creado_en")
  actualizadoEn DateTime              @updatedAt @map("actualizado_en")
  autor         Usuario?              @relation("AutorArticulo", fields: [autorId], references: [id], onDelete: SetNull)
  editadoPor    Usuario?              @relation("EditorArticulo", fields: [editadoPorId], references: [id], onDelete: SetNull)
  archivos      ArchivoConocimiento[]
  accesos       AccesoConocimiento[]

  @@index([categoria])
  @@map("articulos_conocimiento")
}

// Archivo adjunto de un articulo (manual, formato, politica). En disco
// (CONOCIMIENTO_DIR) y solo se sirve a quien puede ver el articulo. Con
// `restringido`, ademas, solo a quienes esten en sus propios accesos.
model ArchivoConocimiento {
  id             String               @id @default(uuid()) @db.VarChar(36)
  articuloId     Int                  @map("articulo_id")
  nombreOriginal String               @map("nombre_original") @db.VarChar(255)
  archivo        String               @unique @db.VarChar(80)
  mime           String               @db.VarChar(100)
  tamano         Int
  sha256         String               @db.VarChar(64)
  restringido    Boolean              @default(false)
  subidoPorId    Int?                 @map("subido_por_id")
  creadoEn       DateTime             @default(now()) @map("creado_en")
  articulo       ArticuloConocimiento @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  subidoPor      Usuario?             @relation("SubeArchivoConocimiento", fields: [subidoPorId], references: [id], onDelete: SetNull)
  accesos        AccesoConocimiento[]

  @@index([articuloId])
  @@map("archivos_conocimiento")
}

// Quien puede ver un articulo o un archivo restringido de la base de
// conocimiento (utils/accesoConocimiento.utils.js). Cuelga del articulo o del
// archivo, y cada fila es una de: una persona (usuarioId), toda un area
// (area), solo los administradores o solo los miembros de un area (area + rol)
// o de todas las areas (rol sin area). rol: admin | miembro.
model AccesoConocimiento {
  id         Int                   @id @default(autoincrement())
  articuloId Int?                  @map("articulo_id")
  archivoId  String?               @map("archivo_id") @db.VarChar(36)
  area       String?               @db.VarChar(40)
  rol        String?               @db.VarChar(10)
  usuarioId  Int?                  @map("usuario_id")
  articulo   ArticuloConocimiento? @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  archivo    ArchivoConocimiento?  @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  usuario    Usuario?              @relation("AccesoConocimientoPersona", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([articuloId])
  @@index([archivoId])
  @@index([usuarioId])
  @@map("accesos_conocimiento")
}

// Papelera: lo que se borra en el CRM no se pierde (services/papelera.service.js).
// Antes de borrar se guarda aqui una copia de la fila y de lo que se borra con
// ella (comentarios y adjuntos de una tarea, archivos de un contrato...), y sus
// archivos se mueven a la carpeta "Papelera" del disco o de Google Drive en vez
// de borrarse. Solo la ve el panel de configuracion; se guarda para siempre
// salvo que alli se elimine a mano. Sin claves foraneas a lo borrado.
model ElementoBorrado {
  id               Int      @id @default(autoincrement())
  // tarea, adjunto, cliente, contrato, pago, articulo... (papelera.service TIPOS)
  tipo             String   @db.VarChar(40)
  modulo           String   @db.VarChar(40)
  entidadId        String?  @map("entidad_id") @db.VarChar(64)
  nombre           String   @db.VarChar(255)
  // Donde estaba: "Proyecto: Rediseño web", "Contrato CT-0012"...
  contexto         String?  @db.VarChar(255)
  datos            Json
  // [{ nombre, mime, tamano, disco: ruta | null, drive: id | null }]
  archivos         Json?
  // usuario | drive (se borro en Google Drive) | calendar (se cancelo en Google Calendar)
  origen           String   @default("usuario") @db.VarChar(20)
  borradoPorId     Int?     @map("borrado_por_id")
  borradoPorNombre String?  @map("borrado_por_nombre") @db.VarChar(255)
  borradoEn        DateTime @default(now()) @map("borrado_en")
  borradoPor       Usuario? @relation("BorradoPor", fields: [borradoPorId], references: [id], onDelete: SetNull)

  @@index([borradoEn])
  @@index([modulo, borradoEn])
  @@map("papelera")
}

// Registro de actividad: quien creo, cambio o borro que y cuando, en todos los
// modulos (services/registroActividad.service.js lo escribe desde el cliente de
// Prisma). `cambios` lleva cada campo editado con su valor anterior y el nuevo.
// Solo lo ve el panel de configuracion.
model RegistroActividad {
  id            Int      @id @default(autoincrement())
  creadoEn      DateTime @default(now()) @map("creado_en")
  usuarioId     Int?     @map("usuario_id")
  usuarioNombre String?  @map("usuario_nombre") @db.VarChar(255)
  // usuario | drive | calendar (cambios que llegan de Google)
  origen        String   @default("usuario") @db.VarChar(20)
  // crear | editar | eliminar
  accion        String   @db.VarChar(20)
  modulo        String   @db.VarChar(40)
  tipo          String   @db.VarChar(40)
  entidadId     String?  @map("entidad_id") @db.VarChar(64)
  entidadNombre String?  @map("entidad_nombre") @db.VarChar(255)
  // [{ campo, antes, despues }]
  cambios       Json?
  ip            String?  @db.VarChar(64)
  usuario       Usuario? @relation("AutorRegistro", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([modulo, creadoEn])
  @@map("registro_actividad")
}
