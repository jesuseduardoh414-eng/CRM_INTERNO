# Variables de entorno del backend. Copia este archivo a `.env` (desarrollo)
# o configuralas en el servidor (Render: Environment; Vercel: Settings >
# Environment Variables; cPanel: "Setup Node.js App" > Environment variables).
# Sin valores reales aqui.

# ---------- Obligatorias (el servidor no arranca sin ellas) ----------
# Base de datos: MySQL/MariaDB o PostgreSQL, la que diga el prefijo de la URL.
# El esquema, las migraciones y el cliente de Prisma se eligen solos segun ese
# prefijo (scripts/prisma.js). Al cambiar de base: npm run db:generate.
#  - XAMPP (root sin clave):   mysql://root:@localhost:3306/crm_interno
#  - cPanel (base y usuario de "Bases de datos MySQL", con el prefijo de la
#    cuenta):                  mysql://cuenta_usuario:CLAVE@localhost:3306/cuenta_crm
#  - Supabase (Project Settings > Database > Connection string, "Transaction
#    pooler", puerto 6543; usuario postgres.PROYECTO) con ?pgbouncer=true.
#    En Vercel (serverless) agrega ademas &connection_limit=1:
#      postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#  - Postgres local:           postgresql://postgres:CLAVE@localhost:5432/crm_interno
# Si la clave lleva @, : o /, codificala (@ = %40, : = %3A, / = %2F).
DATABASE_URL=mysql://USUARIO:CLAVE@localhost:3306/BASE
# Solo Postgres: conexion directa (sin pgbouncer) para las migraciones. En
# Supabase es el mismo pooler en modo sesion, puerto 5432 (funciona por IPv4;
# la conexion "directa" db.PROYECTO.supabase.co es solo IPv6 y Render y Vercel
# no la alcanzan). Si falta se usa DATABASE_URL.
#   postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=
# Opcional: fuerza el proveedor (mysql | postgresql) sin mirar la URL.
DB_PROVIDER=
# Base de ORIGEN para scripts/copiar_base.js (npm run db:copiar), que copia los
# datos a la base de DATABASE_URL. Tambien se puede pasar con --desde.
ORIGEN_DATABASE_URL=
# Secreto con el que se firman los tokens de sesion (JWT). Largo y aleatorio.
JWT_SECRET=define_un_secreto_largo_y_aleatorio

# ---------- Autenticacion y seguridad ----------
# Clave para cifrar (AES-256-GCM) los secretos de la verificacion en dos pasos.
# Larga y aleatoria, DISTINTA de JWT_SECRET. Si falta se deriva de JWT_SECRET,
# pero entonces rotar JWT_SECRET dejaria inservible el 2FA de todos.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_ENCRYPTION_KEY=
# Registro de cuentas desde /registro (el CRM es de uso interno):
#  - cerrado:    (por defecto) solo por invitacion de un admin.
#  - aprobacion: verifican el correo y un admin las aprueba.
#  - abierto:    verifican el correo y entran directamente como MIEMBRO.
REGISTRO_MODO=cerrado
# Opcional: solo estos dominios pueden registrarse (separados por coma).
REGISTRO_DOMINIOS=
# 'true' desactiva la comprobacion de contraseñas filtradas (Have I Been Pwned,
# por k-anonimato: solo viajan 5 caracteres del hash). Dejar vacio.
HIBP_DESACTIVADO=

# ---------- Frontend ----------
# URL publica del frontend. Se usa para la lista blanca de CORS y como base
# de los enlaces que llevan los correos (invitacion, restablecer contraseña,
# verificar cuenta). Si falta, CORS acepta cualquier origen y se avisa por consola.
FRONTEND_URL=https://tu-frontend.vercel.app

# ---------- Servidor ----------
# Puerto en desarrollo. Render y cPanel ponen el suyo en PORT; en Vercel no se usa.
PORT=3000
# 'production' en cualquier servidor. El servidor escucha siempre salvo en
# Vercel (serverless), que se detecta solo por la variable VERCEL.
NODE_ENV=development

# ---------- Correo ----------
# Lo normal es configurarlo en el panel de configuracion (Correo y avisos ->
# Servidor SMTP). Lo de abajo (SMTP con Nodemailer) solo se usa si el panel
# no tiene un servidor SMTP capturado. Sin nada, en desarrollo los correos se
# imprimen en la consola del backend.
#   cPanel:  EMAIL_HOST=mail.tudominio.com  EMAIL_PORT=465
#   Gmail:   EMAIL_HOST=smtp.gmail.com      EMAIL_PORT=587 (contraseña de aplicación)
EMAIL_HOST=
EMAIL_PORT=587
# ssl | starttls | ninguna. Vacío: ssl con el puerto 465, starttls con los demás.
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
# Remitente: "Nombre <correo@dominio>" o solo el correo. Vacío: se usa EMAIL_USER.
EMAIL_FROM=

# ---------- Adjuntos y fotos de perfil ----------
# Se guardan en el disco del servidor. Ruta absoluta o relativa a backend/.
# Por defecto backend/storage/adjuntos. En cPanel, fuera de public_html:
#   ADJUNTOS_DIR=/home/CUENTA/crm_storage/adjuntos
# En Render hace falta un disco persistente (de pago) montado, p. ej. en
# /var/data; sin el, los archivos se pierden en cada despliegue. En Vercel el
# disco es de solo lectura: ahi no se pueden subir archivos.
# Haz respaldo de esta carpeta junto con la base de datos.
ADJUNTOS_DIR=
# Solo para borrar adjuntos antiguos que se subieron a Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# ---------- Contratos (PDF escaneados) ----------
# Carpeta donde se guardan los PDF de contratos. Son confidenciales: NO deben
# estar dentro de public_html ni de ninguna carpeta servida. Por defecto
# backend/storage/contratos. En cPanel, por ejemplo:
#   CONTRATOS_DIR=/home/CUENTA/crm_storage/contratos
# En Vercel el disco no persiste y en Render solo con disco persistente (de
# pago): este modulo necesita un servidor con disco (cPanel, Render con disco).
CONTRATOS_DIR=

# ---------- Google Calendar (opcional, Mi Agenda) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
